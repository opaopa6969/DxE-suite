{
  "name": "@unlaxer/dve-toolkit",
  "version": "4.2.0",
  "description": "DVE (Decision Visualization Engine) — DGE の決定プロセスを可視化するツールキット",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/opaopa6969/DxE-suite"
  },
  "bin": {
    "dve": "./dist/cli/dve-tool.js",
    "dve-install": "./install.sh",
    "dve-update": "./update.sh"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "prepack": "npm run clean && npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "files": ["dist/", "skills/", "scripts/", "CHANGELOG.md", "install.sh", "update.sh", "version.txt"],
  "dependencies": {
    "unified": "^11.0.0",
    "remark-parse": "^11.0.0",
    "remark-frontmatter": "^5.0.0",
    "yaml": "^2.4.0",
    "chokidar": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0"
  }
}
